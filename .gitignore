# OS / editor junk
.DS_Store
.Rproj.user/
*.Rproj

# R session/workspace files (not source code)
.RData
.RDataTmp
.Rhistory
.Rapp.history
.Renviron
Rplots.pdf

# macOS iCloud placeholder files (not-yet-downloaded stubs, not real content)
*.icloud

# Generated/regenerable simulation and analysis outputs -- re-run the scripts to reproduce
simulation/output/
nitrate_data_analysis/output/
functions/tests/output/

# Exploratory/diagnostic test scripts -- local-only, not part of the published repo
**/tests/*.R
**/tests/*.r
**/tests/*.Rmd
**/tests/*.rmd

# SLURM job logs (machine/job-specific, not source code)
slurm-*.out

# Claude Code local (machine-specific) settings
.claude/settings.local.json
